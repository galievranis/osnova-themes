@charset "utf-8";

.dot-loader { --dot-size: 4px; display: flex; }

.dot-loader__item { width: var(--dot-size); height: var(--dot-size); border=
-radius: 50%; background: var(--theme-color-text-secondary); opacity: 0.2; =
}

.app-loaded .dot-loader__item { animation-name: loader-pulse; animation-dur=
ation: 1s; animation-iteration-count: infinite; }

.dot-loader__item:nth-child(2) { animation-delay: 0.1s; }

.dot-loader__item:nth-child(3) { animation-delay: 0.2s; }

.dot-loader__item:not(:last-child) { margin-right: var(--dot-size); }

@keyframes loader-pulse {=20
  0% { opacity: 0.2; }
  24% { opacity: 0.8; }
  48% { opacity: 0.8; }
}

.spinner { --border-color: rgba(0, 0, 0, .3); --border-top-color: rgba(255,=
 255, 255, 1); margin: auto; border-style: solid; border-right-color: ; bor=
der-bottom-color: ; border-left-color: ; border-top-color: var(--border-top=
-color); border-radius: 50%; animation: 0.5s linear 0s infinite normal none=
 running spin; }

.spinner--primary { --border-color: var(--theme-color-accent); --border-top=
-color: transparent; }

.string-loader { display: inline-flex; }

.string-loader > span:last-child::before { content: "..."; opacity: 0; }

.string-loader--loading > span:last-child { position: relative; }

.string-loader--loading > span:last-child::after { content: ""; position: a=
bsolute; bottom: 0px; left: 0px; animation: 1.2s linear 0s infinite normal =
none running string-loader; }

@keyframes string-loader {=20
  0% { content: ""; }
  25% { content: "."; }
  50% { content: ".."; }
  75% { content: "..."; }
}

.circular-progress { --circular-progress-bg: rgba(255, 255, 255, .4); --cir=
cular-progress-bar: var(--color-white); position: relative; display: inline=
-block; }

.circular-progress__svg { transform: rotate(-90deg); }

