{
  "manifest_version": 3,
  "name": "[PD] Osnova Tokens",
  "description": "Редактор CSS-токенов стейджа: две схемы, автосохранение и экспорт изменений.",
  "version": "0.6.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть Osnova Tokens"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://themes-gta.dtf.osnova.app/*"
      ],
      "js": [
        "core.js",
        "color.js",
        "header-color.js",
        "contrast.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "patterns/*.svg"
      ],
      "matches": [
        "https://themes-gta.dtf.osnova.app/*"
      ]
    }
  ]
}
